{
  "name": "vanshade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sun and shade mapper for Metro Vancouver yards. Static site, all compute in the browser.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=Asia/Tokyo vitest run"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "luxon": "^3.7.2",
    "proj4": "^2.22.0",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
