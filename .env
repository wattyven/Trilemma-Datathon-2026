# Build identifier shown in the footer and in <meta name="vanshade-build">. CI overrides it with the commit SHA.
VITE_BUILD_SHA=dev
# Where the site lives, for link previews (og:url, og:image, canonical). Ends with a slash.
# CI can override it with the VITE_SITE_URL repository variable (e.g. for a custom domain).
VITE_SITE_URL=https://vanshade.ca/
